<style>
  html { scroll-behavior: smooth; }
  body { font-family: 'Inter', sans-serif; }

  .hero-bg {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #FDF2E4 0%, #FFF8F0 50%, #FDEBD0 100%);
  }
  .hero-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 15% 80%, rgba(232, 135, 30, 0.12) 0%, transparent 40%),
      radial-gradient(circle at 85% 20%, rgba(107, 78, 46, 0.10) 0%, transparent 40%);
    z-index: 0;
  }
  .hero-illustration {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }
  .hero-content {
    position: relative;
    z-index: 2;
  }

  .service-card {
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .service-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(107, 78, 46, 0.15);
  }
  .service-card:hover .service-icon {
    background: #E8871E;
    color: white;
    transform: rotate(-5deg) scale(1.1);
  }
  .service-icon {
    transition: all 0.4s ease;
  }
  .fade-in {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s ease;
  }
  .fade-in.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .counter {
    font-variant-numeric: tabular-nums;
  }
  .nav-link {
    position: relative;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: #E8871E;
    transition: width 0.3s ease;
  }
  .nav-link:hover::after {
    width: 100%;
  }
  .btn-primary {
    background: linear-gradient(135deg, #E8871E 0%, #C96F10 100%);
    transition: all 0.3s ease;
  }
  .btn-primary:hover {
    background: linear-gradient(135deg, #C96F10 0%, #A85A0A 100%);
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(232, 135, 30, 0.4);
  }
  .float-whatsapp {
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.5); }
    50% { box-shadow: 0 0 0 15px rgba(37, 211, 102, 0); }
  }
  .mobile-menu {
    transform: translateX(100%);
    transition: transform 0.3s ease;
  }
  .mobile-menu.open {
    transform: translateX(0);
  }
  .logo-svg {
    filter: drop-shadow(0 4px 12px rgba(107, 78, 46, 0.15));
  }

  .float-slow { animation: floatSlow 6s ease-in-out infinite; }
  .float-medium { animation: floatMedium 4s ease-in-out infinite; }
  .float-fast { animation: floatFast 3s ease-in-out infinite; }

  @keyframes floatSlow {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
  }
  @keyframes floatMedium {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  @keyframes floatFast {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .gear-rotate {
    animation: gearSpin 20s linear infinite;
  }
  .gear-rotate-reverse {
    animation: gearSpinReverse 25s linear infinite;
  }
  .gear-rotate-slow {
    animation: gearSpin 35s linear infinite;
  }
  @keyframes gearSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  @keyframes gearSpinReverse {
    from { transform: rotate(360deg); }
    to { transform: rotate(0deg); }
  }

  .navbar-dark {
    background: linear-gradient(135deg, #4A3520 0%, #3A2A1A 100%);
    box-shadow: 0 4px 20px rgba(74, 53, 32, 0.3);
  }
</style>
